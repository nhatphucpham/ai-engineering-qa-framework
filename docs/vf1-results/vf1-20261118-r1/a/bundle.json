      "riskRationale": "Incorrect state or cache reuse can display stale items when navigating this synthetic public catalog. The exercise uses one local process with reversible changes. State transitions and cross-request tests address its main risks.",
      "criteria": [
        {
          "id": "AC-01",
          "expected": "Tại service `list_items`, category không rỗng được so khớp chính xác, phân biệt hoa thường; chỉ trả items thuộc category đó và total của tập đã lọc.",
          "mandatory": true,
          "clarification": "clear",
          "ownerRole": "domain-owner",
          "claims": [
            {
              "artifactId": "artifact-1",
              "locator": "AC-01",
              "statement": "Tại service `list_items`, category không rỗng được so khớp chính xác, phân biệt hoa thường; chỉ trả items thuộc category đó và total của tập đã lọc."
            }
          ]
        },
        {
          "id": "AC-02",
          "expected": "Tại UI state `select_category`, mỗi lần chọn category phải đưa page về 1 trước khi gọi API, kể cả đang ở page 3.",
          "mandatory": true,
          "clarification": "clear",
          "ownerRole": "domain-owner",
          "claims": [
            {
              "artifactId": "artifact-1",
              "locator": "AC-02",
              "statement": "Tại UI state `select_category`, mỗi lần chọn category phải đưa page về 1 trước khi gọi API, kể cả đang ở page 3."
            }
          ]
        },
        {
          "id": "AC-03",
          "expected": "Tại API, cache phải giữ kết quả đúng cho từng bộ `(category, page, page_size)`; request category khác nhau trên cùng API instance không được dùng nhầm kết quả.",
          "mandatory": true,
          "clarification": "clear",
          "ownerRole": "domain-owner",
          "claims": [
            {
              "artifactId": "artifact-1",
              "locator": "AC-03",
              "statement": "Tại API, cache phải giữ kết quả đúng cho từng bộ `(category, page, page_size)`; request category khác nhau trên cùng API instance không được dùng nhầm kết quả."
            }
          ]
        },
        {
          "id": "AC-04",
          "expected": "Với một category cố định, service/API trả page ổn định theo thứ tự catalog, tối đa page_size item; page ngoài phạm vi trả items rỗng và giữ total của tập lọc. Tính đúng khi đổi category dùng chung cache được kiểm tra riêng ở AC-03.",
          "mandatory": true,
          "clarification": "clear",
          "ownerRole": "domain-owner",
          "claims": [
            {
              "artifactId": "artifact-1",
              "locator": "AC-04",
              "statement": "Với một category cố định, service/API trả page ổn định theo thứ tự catalog, tối đa page_size item; page ngoài phạm vi trả items rỗng và giữ total của tập lọc. Tính đúng khi đổi category dùng chung cache được kiểm tra riêng ở AC-03."
            }
