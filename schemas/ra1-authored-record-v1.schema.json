{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synthetic-qa:ra1:authored-record:1.0.0",
  "title": "Closed authored input fixture, never executed evidence or authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "origin",
    "runId",
    "jobId",
    "status",
    "finishedAt",
    "inputHashes",
    "execution",
    "ingestionIntervention"
  ],
  "properties": {
    "version": {
      "const": "ra1-authored-record-1.0.0"
    },
    "origin": {
      "const": "authored_fixture"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,95}(?![\\s\\S])"
    },
    "status": {
      "const": "complete"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case/requirements.md",
        "case/head/api.py",
        "case/head/data.py",
        "case/head/service.py",
        "case/head/ui.py",
        "case/tests/test_baseline.py",
        "case/tests/test_historical.py",
        "case/expected/test_probe.py"
      ],
      "properties": {
        "case/requirements.md": {
          "$ref": "#/$defs/sha"
        },
        "case/head/api.py": {
          "$ref": "#/$defs/sha"
        },
        "case/head/data.py": {
          "$ref": "#/$defs/sha"
        },
        "case/head/service.py": {
          "$ref": "#/$defs/sha"
        },
        "case/head/ui.py": {
          "$ref": "#/$defs/sha"
        },
        "case/tests/test_baseline.py": {
          "$ref": "#/$defs/sha"
        },
        "case/tests/test_historical.py": {
          "$ref": "#/$defs/sha"
        },
        "case/expected/test_probe.py": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "testId",
              "outcome",
              "traceText"
            ],
            "properties": {
              "testId": {
                "enum": [
                  "Baseline.test_service_category_and_case",
                  "Baseline.test_service_pagination_and_out_of_range",
                  "Baseline.test_empty_category",
                  "Baseline.test_api_repeat_same_request",
                  "Baseline.test_api_page_and_size",
                  "Baseline.test_ui_select_from_first_page",
                  "Historical.test_reset_from_third_page",
                  "Probe.test_reset_with_recorded_api_call",
                  "Probe.test_cache_across_categories"
                ]
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "skipped"
                ]
              },
              "traceText": {
                "const": ""
              }
            }
          }
        }
      }
    },
    "ingestionIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withheldTestIds",
        "appliedBeforeHostRequest"
      ],
      "properties": {
        "withheldTestIds": {
          "const": [
            "Baseline.test_api_page_and_size"
          ]
        },
        "appliedBeforeHostRequest": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
